/* Action guidance extends the existing landscape without changing its art. */
.journey-stops{flex-wrap:wrap;gap:5px 13px}.journey-stops span{font-size:12px}.objective{width:min(350px,32vw)}.objective .overline{letter-spacing:.10em}.compass-hint{position:absolute;top:90px;left:50%;transform:translateX(-50%);max-width:46vw;text-align:center;background:#17382cce;border:1px solid #dbc79455;border-radius:20px;padding:8px 15px;font-size:14px;color:#f6e7bd}.conversation-hint{position:absolute;bottom:260px;left:50%;transform:translateX(-50%);max-width:80vw;padding:10px 18px;background:#183c32f5;border:1px solid #d2bd8855;border-radius:5px;font-size:15px;text-align:center}.reflection-panel{position:absolute;top:130px;right:32px;width:min(340px,34vw);padding:22px;background:#15382cf5;border-top:1px solid #ddc18a;border-radius:5px}.reflection-panel h2{font:28px Georgia;margin:4px 0 14px}.reflection-panel>p:not(.overline){font-size:16px;line-height:1.55}.reflection-question{color:#f6dda4}.reflection-panel small{font-size:14px;line-height:1.5;display:block;color:#ced9c5}.setting.voice-setting{display:block}.voice-setting>span{display:block;margin-bottom:10px}.voice-setting select{width:100%;max-width:100%}.setting output{font-size:14px;color:#e4c890}.memory-grid{grid-template-columns:1fr 1fr}.memory-grid p{font-size:15px}.memory-grid span{font-size:13px}.interaction{max-width:min(660px,75vw);white-space:normal;text-align:center;bottom:28%}.subtitle{bottom:100px;max-width:calc(100vw - 360px)}.insight{pointer-events:none}.balance{top:137px}.world-marker span{max-width:240px;white-space:normal;text-align:center}body.radio-open .compass-hint{visibility:hidden}body:has(#reflectionPanel:not(.hidden)) #insight{display:none}body:has(#reflectionPanel:not(.hidden)) .objective{opacity:.65}
@media(max-width:1000px){.compass-hint{top:auto;bottom:57px;max-width:60vw}.balance{top:80px;left:65%}.reflection-panel{top:120px;right:20px;width:300px}.subtitle{max-width:calc(100vw - 250px)}}
@media(pointer:coarse){.compass-hint{bottom:18px;max-width:50vw;font-size:13px}.subtitle{bottom:160px}.interaction{bottom:285px}.balance{top:280px;left:20%;width:210px}.conversation-hint{bottom:285px}.desktop-controls{display:none}}
@media(max-width:600px){.objective{width:calc(100% - 135px)}.hud-buttons{gap:5px}.hud-top .brand span{font-size:9px}.hud-top .brand b{font-size:23px}.round-button{width:33px;height:33px}.subtitle{max-width:none;width:calc(100% - 28px);bottom:165px}.interaction{max-width:94vw;bottom:300px}.compass-hint{bottom:12px;font-size:12px;max-width:53vw}.reflection-panel{top:auto;bottom:305px;left:14px;right:14px;width:auto;padding:15px}.reflection-panel h2{font-size:24px}.reflection-panel>p:not(.overline){font-size:14px;line-height:1.4}.reflection-panel small{font-size:13px}.reflection-panel .overline{margin-bottom:5px}.reflection-question{line-height:1.65!important}.memory-grid{grid-template-columns:1fr}.balance{top:265px;left:50%;width:220px}.sound-caption{bottom:276px}.conversation-hint{bottom:310px;font-size:14px}body:has(#reflectionPanel:not(.hidden)) .objective{display:none}body:has(#reflectionPanel:not(.hidden)) #interaction{bottom:270px}}
@media(max-height:600px) and (min-width:601px){.objective{width:265px;top:78px;padding:12px 15px}.objective h2{font-size:19px}.objective>p:not(.overline){font-size:14px}.journey-stops{display:none}.compass-hint{bottom:12px;top:auto}.subtitle{bottom:92px;max-width:70vw;width:70vw}.subtitle p{font-size:15px}.interaction{bottom:185px;font-size:14px}.balance{top:20px;left:53%}.reflection-panel{top:90px;right:16px;width:290px;padding:14px}.reflection-panel h2{font-size:23px}.reflection-panel>p:not(.overline){font-size:14px}.reflection-panel small{font-size:13px}.conversation-hint{bottom:210px}.insight{top:78px}}
/* The closing idea stays connected to evidence and the next Design Thinking phases. */
.end-dialog{max-width:900px}.thinking-route{display:flex;flex-wrap:wrap;gap:8px;margin:22px 0 28px}.thinking-route span{font-size:14px;border-bottom:2px solid #819b7a;padding:8px 12px;color:#cbd7c3}.thinking-route .active{color:#f4dda8;border-color:#e5c487}.idea-section{border-top:1px solid #b6c0a13b;padding-top:20px;margin:24px 0}.idea-section .overline{font-size:13px;letter-spacing:.1em}.idea-section h3{font:27px/1.2 Georgia;color:#eed8a8;margin:6px 0 14px}.idea-section p,.idea-evidence{font-size:16px;line-height:1.65;color:#d9e1d1}.idea-evidence{padding-left:20px}.idea-evidence li{margin-bottom:12px}.idea-section details{margin-bottom:0}.reflection-inline{font-style:italic}.idea-challenge{margin:20px 0 0;padding:20px 23px;border-left:3px solid #e4c584;background:#e3c18612;font:24px/1.4 Georgia;color:#f4dfb3}.idea-seed{padding:24px;border:1px solid #d4bf835e;border-radius:6px;background:#e0c58e0a}.idea-seed h3{font-size:33px}.idea-parts{display:grid;grid-template-columns:1fr 1fr;gap:0 22px}.idea-parts b{color:#efdab0}.idea-next{display:grid;grid-template-columns:1fr 1fr;gap:26px}.idea-next .idea-section{margin:0}.end-dialog .dialog-actions{position:sticky;bottom:-36px;margin:28px -4px -4px;padding:16px 4px 4px;background:#17392ff7}.end-dialog .setting-note{font-size:14px!important}
@media(max-width:600px){.idea-parts,.idea-next{grid-template-columns:1fr}.idea-seed{padding:18px}.idea-section h3{font-size:25px}.idea-challenge{font-size:21px;padding:17px}.thinking-route{gap:4px}.thinking-route span{padding:7px 8px;font-size:13px}.end-dialog .dialog-actions{position:static}}
/* Leave the action area clear when the camera frames hands and objects. */
body.camera-action .objective,body.camera-action .map-wrap{opacity:.16;transition:opacity .4s}body.camera-action .insight,body.camera-action .world-marker,body.camera-action .compass-hint{visibility:hidden}body.camera-action .subtitle{bottom:25px;width:min(760px,80vw);max-width:80vw;background:#12251df2}body.camera-action .interaction{bottom:155px;max-width:76vw}body.camera-action .sound-caption{bottom:215px}body.camera-action .desktop-controls{opacity:0}body.camera-action .balance{top:90px}body.camera-action .conversation-hint{bottom:215px}
@media(pointer:coarse){body.camera-action .subtitle{bottom:150px;width:76vw;max-width:76vw}body.camera-action .interaction{bottom:285px}body.camera-action .sound-caption{bottom:335px}}
@media(max-width:600px){body.camera-action .objective,body.camera-action .map-wrap{visibility:hidden}body.camera-action .subtitle{bottom:155px;width:calc(100% - 24px);max-width:none;font-size:14px}body.camera-action .interaction{bottom:295px;max-width:94vw}body.camera-action .sound-caption{bottom:343px;font-size:13px}body.camera-action .reflection-panel{bottom:315px}}
@media(max-height:600px) and (min-width:601px){body.camera-action .subtitle{bottom:12px;width:64vw;max-width:64vw}body.camera-action .interaction{bottom:115px;max-width:70vw}body.camera-action .sound-caption{bottom:165px}body.camera-action .map-wrap{visibility:hidden}body.camera-action .conversation-hint{bottom:165px}}
</style>
</head>
<body>
 <main id="game" aria-label="HABITAR. Aventura tridimensional por un territorio ficticio de Antioquia">
  <canvas id="world" tabindex="0" aria-label="Territorio 3D. Usa WASD o flechas para caminar; arrastra para mirar; E para participar; mantén Q para observar o regar; R repite la voz; I J K L orientan la cámara; H abre la guía."></canvas>
  <div class="vignette" aria-hidden="true"></div>
  <div id="loading" class="loading"><span class="sun-mark" aria-hidden="true">H</span><h1>HABITAR</h1><p id="loadingText">Preparando el territorio…</p><div class="load-track"><i></i></div></div>
  <section id="start" class="start hidden" aria-label="Inicio del juego">
   <div class="start-shade"></div>
   <div class="start-copy"><p class="overline">ANTIOQUIA CHALLENGE</p><h1>HABITAR</h1><p class="tagline">Lo que nos une.</p><div class="gold-rule"></div>
    <h2>Antes de transformar un lugar,<br>aprende a estar en él.</h2>
    <p class="intro">Observa, escucha y pregunta. Comparte tareas, acompaña otros recorridos y comprueba con las personas qué les ayuda a participar.</p>
    <button id="begin" class="primary">Entrar al territorio <span class="play-mark" aria-hidden="true">▷</span></button>
    <div class="start-secondary"><button id="startGuide" class="text-button">Cómo jugar</button><button id="startSettings" class="text-button">Sonido y gráficos</button></div>
    <p class="start-meta">Seis experiencias conectadas · A tu propio ritmo<br>Personaje y mundo 3D · Sin IA durante el juego</p>
   </div>
   <div class="scene-caption"><span>UN TERRITORIO, MUCHAS MIRADAS</span><p>Un lugar ficticio inspirado en la Antioquia andina.</p></div>
  </section>
  <section id="hud" class="hidden" aria-label="Indicaciones del recorrido">
   <header class="hud-top">
    <div class="brand"><span>ANTIOQUIA CHALLENGE</span><b>HABITAR</b></div>
    <nav class="hud-buttons" aria-label="Controles del juego"><button id="soundButton" class="round-button" aria-label="Silenciar audio" title="Sonido"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 9v6h4l5 4V5L8 9zM17 8c3 2 3 6 0 8M19 4c6 5 6 11 0 16"/></svg></button><button id="replayVoice" class="round-button" aria-label="Volver a escuchar la última intervención" title="Repetir voz · R">↻</button><button id="helpButton" class="round-button" aria-label="Cómo jugar y propósito pedagógico" title="Guía · H">?</button><button id="pauseButton" class="round-button" aria-label="Pausa y ajustes" title="Pausa · Esc">Ⅱ</button></nav>
   </header>
   <div class="objective"><p id="chapter" class="overline">01 / LA RIBERA</p><h2 id="objectiveTitle">Escucha lo que sostiene la vida</h2><p id="objectiveHint">Acércate a la orilla.</p><div class="journey-stops" aria-label="Espacios del recorrido"><span data-stop="0">Observar</span><span data-stop="1">Compartir</span><span data-stop="2">Acompañar</span><span data-stop="3">Preguntar</span><span data-stop="4">Reflexionar</span><span data-stop="5">Comprender</span></div></div>
   <div id="compassHint" class="compass-hint">Sigue la luz</div><div id="conversationHint" class="conversation-hint hidden" role="status"></div><div id="placeName" class="place-name" aria-hidden="true">La ribera</div>
   <div id="marker" class="world-marker hidden" aria-hidden="true"><i></i><span id="markerLabel"></span><small id="markerDistance"></small></div>
   <div id="interaction" class="interaction hidden"><kbd id="interactionKey">E</kbd><span id="interactionText"></span><div class="hold-track hidden" id="holdTrack"><i id="holdFill"></i></div></div>
   <div id="balance" class="balance hidden"><span>Compartir el ritmo</span><div class="balance-track"><i id="balanceFill"></i></div><small id="balanceHint">Pasos tranquilos, giros suaves.</small></div>
   <div id="soundCaption" class="sound-caption hidden" aria-live="polite"></div>
   <div id="subtitle" class="subtitle hidden" role="status" aria-live="polite"><strong id="speaker"></strong><p id="speech"></p></div>
   <section id="reflectionPanel" class="reflection-panel hidden"><p class="overline">AUTORREFLEXIÓN</p><h2>Volver a mirar</h2><p>El camino más corto no era el que Lucía necesitaba. Una invitación digital no llegaba de la misma manera a todas las personas.</p><p class="reflection-question">¿Qué di por hecho al llegar?<br>¿Qué cambió después de escuchar?<br>¿Qué necesito seguir preguntando?</p><small>Reflexiona en silencio o conversa con tu equipo. Continúa con E cuando lo decidas.</small></section><div id="insight" class="insight hidden" role="status"><span id="insightLabel"></span><p id="insightText"></p></div>
   <footer class="hud-bottom"><div class="desktop-controls"><span><kbd>W A S D</kbd> Caminar</span><span><kbd>ARRASTRA</kbd> Mirar</span><span><kbd>E</kbd> Participar</span><span><kbd>Q</kbd> Observar / regar</span></div><div class="map-wrap"><canvas id="map" width="360" height="360" aria-label="Mapa de orientación: muestra tu posición y el encuentro actual"></canvas><span id="mapCaption">El territorio</span></div></footer>
   <div class="touch-controls"><div id="joystick" aria-label="Arrastra para caminar"><div id="joystickKnob"></div></div><div class="touch-actions"><button id="touchListen" aria-label="Mantener para observar o regar">Q<small id="touchListenLabel">Observar</small></button><button id="touchAction" aria-label="Participar en la acción cercana">E<small>Participar</small></button></div></div>
  </section>
  <section id="radioPanel" class="radio-panel hidden" aria-label="Sintonizar la radio comunitaria">
   <p class="overline">VOCES DEL TERRITORIO</p><h2>Un lugar. Distintas voces.</h2><p>Busca 89.2 y 102.4 FM. Mantén cada señal para escuchar la voz completa; después llevarás las invitaciones a los lugares acordados.</p>
   <div class="radio-dial"><div class="frequency"><span id="frequency">86.0</span><small>FM</small></div><div class="dial-scale" aria-hidden="true"><i id="dialNeedle"></i></div><div class="dial-labels" aria-hidden="true"><span>86</span><span>92</span><span>98</span><span>104</span><span>108</span></div></div>
   <label for="tuning" class="sr-only">Frecuencia de la radio entre 86 y 108</label><input id="tuning" type="range" min="86" max="108" step="0.1" value="86">
   <p id="radioStatus" class="radio-status" role="status">Busca una señal con A / D, las flechas o el dial.</p><div class="radio-voices"><span id="voice0">Voz por descubrir</span><span id="voice1">Voz por descubrir</span></div><button id="leaveRadio" class="secondary">Volver al recorrido</button>
  </section>
  <section id="fatal" class="fatal hidden" role="alert"><h1>No se pudo iniciar el mundo 3D.</h1><p id="fatalText">Este juego necesita WebGL 2 y aceleración gráfica. Prueba un navegador actualizado en un equipo con aceleración de hardware.</p><button onclick="location.reload()" class="primary">Intentar de nuevo</button></section>
 </main>
 <dialog id="helpDialog" class="dialog help-dialog"><button class="dialog-close" data-close aria-label="Cerrar guía">×</button><p class="overline">GUÍA DE CAMPO</p><h2>Aprende a estar aquí.</h2><p>No tienes que acertar respuestas. Avanza observando, escuchando y participando en seis experiencias. La luz señala la siguiente acción: un halo alrededor de la persona u objeto y un círculo en el suelo. Al acercarte verás qué puedes hacer.</p>
  <div class="guide-controls"><div><kbd>W A S D</kbd><b>Caminar</b><span>También puedes usar las flechas. Shift permite un paso más rápido.</span></div><div><kbd>RATÓN</kbd><b>Mirar alrededor</b><span>Mantén pulsado y arrastra. La rueda acerca o aleja la cámara. Sin ratón, usa J / L para girar e I / K para inclinar. Durante las acciones, la cámara encuadra las manos y el objeto de lado; puedes reajustarla arrastrando.</span></div><div><kbd>E</kbd><b>Participar</b><span>Acércate a una persona u objeto. La indicación aparece cuando puedes actuar.</span></div><div><kbd>Q</kbd><b>Observar y cuidar</b><span>Mantén Q junto al agua, al árbol o al semillero. Suelta para continuar. R vuelve a reproducir una intervención.</span></div></div>
  <p class="touch-help">En pantalla táctil: usa el mando izquierdo para caminar, arrastra el lado derecho para mirar y pulsa los botones Q / E.</p>
  <div class="guide-route"><p><b>01 · Observar y escuchar.</b> Detente junto al agua y al árbol con Q. Pregunta a Mateo con E, escucha, toma la regadera, llénala en la orilla y llévala al semillero. Mantén Q para regar.</p><p><b>02 · Compartir el ritmo.</b> Lleva la bandeja de macetas con Inés: camina sin correr, gira suavemente y deposítala con E en la mesa iluminada.</p><p><b>03 · Cambiar de perspectiva.</b> Pregunta a Lucía y acompáñala. Cuando se detenga, pregunta por la caja; muévela al lugar acordado y continúa junto a ella.</p><p><b>04 · Preguntar y contrastar.</b> Pregunta a Julián. Escucha dos voces en la radio, recoge las invitaciones y llévalas a las carteleras de la escuela y la huerta.</p><p><b>05 · Autorreflexión.</b> Siéntate en el banco iluminado. Revisa tu primera impresión y lo que cambió al escuchar. No hay respuestas que seleccionar: toma una pausa y continúa con E.</p><p><b>06 · Identificar necesidades.</b> Escucha a Rosa, lleva un asiento al lugar que indica y pregúntale si le sirve. Después regresa al encuentro. Allí conectarás las evidencias con una necesidad, una idea inicial y los siguientes pasos de Design Thinking. Puedes guardar esa idea para continuar.</p></div>
  <details><summary>Para docentes: intención y límites de la experiencia</summary><p>La dimensión Relacionarse se trabaja desde el aprecio, la conexión, la humildad y la empatía-compasión. Las acciones son una invitación a practicar atención y reciprocidad: no constituyen una prueba de empatía.</p><p>El territorio, sus habitantes y sus voces son ficticios. No representan a todos los municipios ni diagnostican sus necesidades. El juego prepara un encuentro de campo; no sustituye la observación, la conversación abierta ni la validación con las comunidades.</p><p>Una necesidad es una condición que la persona requiere para participar o vivir mejor. El asiento es una posible respuesta; poder conversar sin agotarse y bajo la sombra es la necesidad expresada por Rosa. Al salir al territorio: registra hechos y palabras, separa tus interpretaciones, reconoce lo que ya funciona y contrasta perspectivas antes de definir una necesidad o proponer una solución.</p></details>
  <button class="primary" data-close>Volver</button>
 </dialog>
 <dialog id="settingsDialog" class="dialog settings-dialog"><button class="dialog-close" data-close aria-label="Cerrar ajustes">×</button><p class="overline">UNA PAUSA EN EL CAMINO</p><h2>Tu experiencia</h2>
  <label class="setting"><span>Sonido del territorio</span><input id="volume" type="range" min="0" max="100" value="65" aria-label="Volumen general"></label>
  <label class="setting"><span>Música ambiental</span><input id="musicVolume" type="range" min="0" max="100" value="34" aria-label="Volumen de la música"></label>
  <label class="setting check"><input id="voiceToggle" type="checkbox" checked><span>Narración y conversaciones</span></label><label class="setting voice-setting"><span>Voz en español</span><select id="voiceSelect" aria-label="Elegir una voz local en español"><option value="">Automática</option></select></label><p id="voiceStatus" class="setting-note">Buscando voces locales en español.</p><label class="setting"><span>Velocidad de la voz <output id="voiceRateValue">0.94×</output></span><input id="voiceRate" type="range" min="0.8" max="1.15" step="0.01" value="0.94" aria-label="Velocidad de narración"></label><label class="setting"><span>Volumen de la voz</span><input id="voiceVolume" type="range" min="0" max="150" value="100" aria-label="Volumen de la voz"></label><button id="voiceTest" class="secondary">Escuchar esta voz</button><p class="setting-note">Las voces son las instaladas en este dispositivo. Se priorizan las voces naturales locales disponibles. La música baja durante las conversaciones. Los subtítulos permanecen activos; no se necesitan servicios externos.</p>
  <label class="setting"><span>Calidad gráfica</span><select id="quality"><option value="high">Alta · sombras detalladas</option><option value="balanced" selected>Equilibrada</option><option value="low">Ligera · sin sombras dinámicas</option></select></label>
  <label class="setting check"><input id="reducedMotion" type="checkbox"><span>Reducir movimiento ambiental y de cámara</span></label>
  <p class="setting-note">Si notas lentitud, elige Equilibrada o Ligera. No hay límite de tiempo. Esc pausa el juego; H abre la guía.</p><div class="dialog-actions"><button class="primary" data-close>Continuar</button><button id="restart" class="secondary">Reiniciar recorrido</button></div>
  <p class="offline-link">Edición autónoma · Todos los recursos están integrados en este archivo.</p>
 </dialog>
 <dialog id="restartDialog" class="dialog"><p class="overline">EMPEZAR DE NUEVO</p><h2>¿Reiniciar este recorrido?</h2><p>Volverás a la ribera. No se guardan datos personales ni se envían tus acciones a ningún servicio.</p><div class="dialog-actions"><button id="confirmRestart" class="primary">Reiniciar</button><button class="secondary" data-close>Cancelar</button></div></dialog>
 <dialog id="endDialog" class="dialog end-dialog" aria-labelledby="endTitle"><p class="overline">HABITAR · DEL RECORRIDO A LA IDEACIÓN</p><h2 id="endTitle">Lo que comprendiste<br>puede convertirse en una idea.</h2><p>Las acciones del recorrido dejan pistas para formular un reto, imaginar respuestas y ensayarlas con las personas.</p>
  <div class="thinking-route" aria-label="Fases de Design Thinking"><span>Empatizar</span><span>Definir</span><span class="active">Idear</span><span>Prototipar</span><span>Probar</span></div>
  <section class="idea-section"><p class="overline">01 · EMPATIZAR</p><h3>De las acciones a las evidencias</h3><ul id="ideaEvidence" class="idea-evidence"></ul><details><summary>Los pasos que recorriste</summary><div id="journeyMemories" class="memory-grid"></div></details><p class="reflection-inline">Antes de seguir: ¿qué di por hecho?, ¿qué cambió al escuchar?, ¿qué voces faltan?</p></section>
  <section class="idea-section"><p class="overline">02 · DEFINIR</p><h3>Una necesidad que une lo vivido</h3><p id="ideaNeed"></p><blockquote id="ideaChallenge" class="idea-challenge"></blockquote></section>
  <section class="idea-section idea-seed"><p class="overline">03 · IDEAR · UNA PROPUESTA INICIAL</p><h3 id="ideaTitle"></h3><p id="ideaProposal"></p><div id="ideaParts" class="idea-parts"></div><p id="ideaAlternatives"></p></section>
  <div class="idea-next"><section class="idea-section"><p class="overline">04 · PROTOTIPAR</p><h3>Un primer ensayo</h3><p id="ideaPrototype"></p></section><section class="idea-section"><p class="overline">05 · PROBAR</p><h3>Escuchar y ajustar</h3><p id="ideaTest"></p></section></div>
  <p id="ideaCaveat" class="setting-note"></p><div class="dialog-actions"><button id="saveIdea" class="primary">Guardar idea y siguientes pasos</button><button id="explore" class="secondary">Volver al territorio</button><button id="endRestart" class="text-button">Vivirlo otra vez</button></div>
 </dialog>
 <noscript><section class="fatal"><h1>HABITAR necesita JavaScript.</h1><p>Activa JavaScript para iniciar el mundo 3D. El archivo LEEME de la descarga contiene las instrucciones completas.</p></section></noscript>
